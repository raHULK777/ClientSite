{
  "name": "constructops",
  "version": "0.1.0",
  "private": true,
  "description": "ConstructOps Engine - multi-tenant white-label contractor platform",
  "workspaces": [
    "constructops-core",
    "constructops-web",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @constructops/core",
    "dev:web": "npm run dev -w @constructops/web",
    "build": "npm run build -w @constructops/core && npm run build -w @constructops/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w @constructops/core",
    "db:seed": "npm run db:seed -w @constructops/core"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "^15.1.6",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1"
  },
  "dependencies": {
    "agent-browser": "^0.41.0"
  },
  "allowScripts": {
    "agent-browser@0.41.0": true
  }
}
