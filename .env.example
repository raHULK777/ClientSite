# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Data ───────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the local PGlite development database.
# Example production value: postgresql://user:pass@host:5432/constructops
DATABASE_URL=

# Leave REDIS_URL empty to use the in-memory tenant cache.
# Example production value: redis://localhost:6379
REDIS_URL=

# ── Auth ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Automated test runs only; never enable in production.
RATE_LIMIT_DISABLED=false

# ── Tenancy ────────────────────────────────────────────────
TENANT_CACHE_TTL_SECONDS=3600
# Used for local development when the Host header is localhost.
# Example: X-Tenant-Host: santos.localhost
DEV_TENANT_HOST=santos.localhost

# ── Public web ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
